---
import { Image } from "astro:assets";
import { navLinks, siteConfig } from "../../data/site-config";
import { legalDocs } from "../../data/legal";
import { BASE_URL } from "../../lib/baseUrl";
import logo from "../../assets/branding/tarik-real-estate-logo.png";

const year = new Date().getFullYear();
---

<footer class="bg-[#111] text-white px-6 lg:px-10" role="contentinfo">
  <div class="max-w-350 mx-auto">
    {/* Main footer grid */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 py-16 lg:py-20 border-b border-white/10">
      {/* Brand column */}
      <div class="lg:col-span-1">
        {/* Logo — the client's full, unmodified logo file */}
        <a href={BASE_URL} class="inline-block mb-6 focus-visible:outline-gold" aria-label="Tarik Real Estate home">
          <Image src={logo} alt="Tarik Real Estate" class="h-24 w-auto object-contain" />
        </a>

        <p class="text-white/40 text-[13px] leading-relaxed max-w-55 mb-6">
          Personal real estate guidance in Alexandria, Virginia and the Northern Virginia DMV area.
        </p>

        {/* Social links */}
        <div class="flex items-center gap-3">
          <a
            href={siteConfig.socialLinks.facebook}
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 border border-white/15 flex items-center justify-center text-white/40 hover:text-gold hover:border-gold transition-colors duration-200 focus-visible:outline-gold"
            aria-label="Tarik Real Estate on Facebook"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z" />
            </svg>
          </a>
          <a
            href={siteConfig.socialLinks.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 border border-white/15 flex items-center justify-center text-white/40 hover:text-gold hover:border-gold transition-colors duration-200 focus-visible:outline-gold"
            aria-label="Tarik Real Estate on Instagram"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" />
              <path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z" />
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
            </svg>
          </a>
          <a
            href={siteConfig.socialLinks.tiktok}
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 border border-white/15 flex items-center justify-center text-white/40 hover:text-gold hover:border-gold transition-colors duration-200 focus-visible:outline-gold"
            aria-label="Tarik Real Estate on TikTok"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16.5 2h-3v14.5a2.5 2.5 0 11-2.5-2.5c.17 0 .34.01.5.04V10.9a5.5 5.5 0 105.5 5.5V8.5a7.44 7.44 0 004.5 1.5v-3a4.5 4.5 0 01-4.5-4.5z" stroke-linejoin="round" />
            </svg>
          </a>
          <a
            href={siteConfig.contact.whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 border border-white/15 flex items-center justify-center text-white/40 hover:text-gold hover:border-gold transition-colors duration-200 focus-visible:outline-gold"
            aria-label="Message Tarik Real Estate on WhatsApp"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2a9.98 9.98 0 00-8.62 15.02L2 22l5.12-1.34A10 10 0 1012 2z" />
              <path d="M8.5 8.6c.2-.5.4-.6.7-.6h.5c.2 0 .3.1.4.3.2.4.6 1.4.7 1.5.1.2.1.3 0 .5-.1.2-.2.3-.3.4-.2.2-.3.3-.1.6.2.3.7 1 1.4 1.6.8.7 1.5 1 1.8 1.1.2.1.4.1.5-.1.2-.2.6-.7.8-.9.2-.2.3-.2.5-.1.2.1 1.3.6 1.5.7.2.1.4.2.4.3.1.2 0 .8-.2 1.1-.3.4-1.1.7-1.6.8-.5.1-1 .1-2.9-.7-1.9-.8-3.4-2.5-3.5-2.6-.1-.2-.9-1.2-.9-2.3 0-1.1.6-1.7.8-1.9z" />
            </svg>
          </a>
        </div>
      </div>

      {/* Navigation */}
      <div>
        <h3 class="text-white/50 text-[10px] tracking-[0.25em] uppercase font-medium mb-5">
          Navigation
        </h3>
        <nav aria-label="Footer navigation">
          <ul class="space-y-3">
            {navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-white/50 text-[13px] hover:text-gold transition-colors duration-200 focus-visible:outline-gold"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>

      {/* Contact */}
      <div>
        <h3 class="text-white/50 text-[10px] tracking-[0.25em] uppercase font-medium mb-5">
          Contact
        </h3>
        <div class="space-y-3">
          <div>
            <p class="text-white/30 text-[10px] tracking-widest uppercase mb-1">Phone</p>
            <a href={siteConfig.contact.phoneHref} class="text-white/50 text-[13px] hover:text-gold transition-colors duration-200 focus-visible:outline-gold">
              {siteConfig.contact.phone}
            </a>
          </div>
          <div>
            <p class="text-white/30 text-[10px] tracking-widest uppercase mb-1">Email</p>
            <a href={`mailto:${siteConfig.contact.email}`} class="text-white/50 text-[13px] hover:text-gold transition-colors duration-200 focus-visible:outline-gold">
              {siteConfig.contact.email}
            </a>
          </div>
          <div>
            <p class="text-white/30 text-[10px] tracking-widest uppercase mb-1">Location</p>
            <p class="text-white/50 text-[13px]">{siteConfig.contact.location}</p>
            <p class="text-white/30 text-[11px]">{siteConfig.contact.serviceArea}</p>
          </div>
        </div>
      </div>

      {/* Areas served */}
      <div>
        <h3 class="text-white/50 text-[10px] tracking-[0.25em] uppercase font-medium mb-5">
          Areas Served
        </h3>
        <ul class="space-y-2">
          {siteConfig.areasServed.map((area) => (
            <li>
              <a
                href="#areas"
                class="text-white/50 text-[13px] hover:text-gold transition-colors duration-200 focus-visible:outline-gold"
              >
                {area}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    {/* Bottom bar */}
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 py-6">
      <p class="text-white/25 text-[11px] tracking-wide">
        &copy; {year} Tarik Real Estate. All Rights Reserved.
      </p>
      <div class="flex items-center gap-6">
        <button
          type="button"
          data-legal-open
          data-legal-id="privacy"
          class="text-white/25 text-[11px] hover:text-white/50 transition-colors duration-200 focus-visible:outline-gold"
        >
          Privacy Policy
        </button>
        <span class="text-white/15 text-[11px]">|</span>
        <button
          type="button"
          data-legal-open
          data-legal-id="terms"
          class="text-white/25 text-[11px] hover:text-white/50 transition-colors duration-200 focus-visible:outline-gold"
        >
          Terms
        </button>
      </div>
    </div>
  </div>

  {/* Legal modal — pre-rendered Privacy Policy / Terms content, toggled by JS */}
  <div
    data-legal-modal
    class="hidden fixed inset-0 z-200 items-center justify-center bg-charcoal/80 p-4"
  >
    <div
      role="dialog"
      aria-modal="true"
      tabindex="-1"
      data-legal-dialog
      class="relative w-full max-w-2xl max-h-[85vh] overflow-y-auto bg-cream shadow-2xl outline-none animate-scale-in text-charcoal"
    >
      <button
        type="button"
        data-legal-close
        aria-label="Close"
        class="absolute top-4 right-4 z-10 w-8 h-8 flex items-center justify-center bg-cream/90 text-warm-gray-light hover:text-charcoal focus-visible:outline-gold transition-colors duration-200"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M12 4L4 12M4 4l8 8" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
        </svg>
      </button>

      {legalDocs.map((doc) => (
        <div data-legal-panel={doc.id} hidden class="p-8 lg:p-10">
          <h2
            id={`legal-modal-title-${doc.id}`}
            class="font-serif text-charcoal text-2xl lg:text-3xl font-medium leading-snug mb-2"
          >
            {doc.title}
          </h2>
          <p class="text-warm-gray-light text-[12px] tracking-wide uppercase mb-8">
            Last updated{" "}
            {new Date(doc.updatedAt).toLocaleDateString("en-US", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })}
          </p>
          <div class="space-y-6">
            {doc.sections.map((section) => (
              <div>
                <h3 class="font-serif text-charcoal text-base font-medium mb-2">
                  {section.heading}
                </h3>
                <div class="space-y-3 text-warm-gray text-[14px] leading-relaxed">
                  {section.body.map((paragraph) => (
                    <p>{paragraph}</p>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</footer>

<script>
  // Dependency-free modal, same pattern as the article modal — Privacy
  // Policy / Terms content is pre-rendered and just toggled by id, instead
  // of routing to pages that don't exist yet.
  const modal = document.querySelector<HTMLElement>("[data-legal-modal]");
  const dialog = document.querySelector<HTMLElement>("[data-legal-dialog]");
  const panels = Array.from(document.querySelectorAll<HTMLElement>("[data-legal-panel]"));

  if (modal && dialog && panels.length) {
    let previouslyFocused: HTMLElement | null = null;

    const openLegal = (id: string) => {
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.legalPanel !== id;
      });
      dialog.setAttribute("aria-labelledby", `legal-modal-title-${id}`);
      previouslyFocused = document.activeElement as HTMLElement | null;
      modal.classList.remove("hidden");
      modal.classList.add("flex");
      document.documentElement.style.overflow = "hidden";
      document.body.style.overflow = "hidden";
      dialog.scrollTop = 0;
      dialog.focus({ preventScroll: true });
    };

    const closeLegal = () => {
      modal.classList.add("hidden");
      modal.classList.remove("flex");
      document.documentElement.style.overflow = "";
      document.body.style.overflow = "";
      previouslyFocused?.focus({ preventScroll: true });
    };

    document.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      const trigger = target.closest<HTMLElement>("[data-legal-open]");
      if (trigger) {
        event.preventDefault();
        const id = trigger.dataset.legalId;
        if (id) openLegal(id);
        return;
      }
      if (!modal.classList.contains("hidden") && (target === modal || target.closest("[data-legal-close]"))) {
        closeLegal();
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !modal.classList.contains("hidden")) {
        closeLegal();
      }
    });
  }
</script>
