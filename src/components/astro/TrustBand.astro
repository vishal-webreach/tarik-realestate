---
interface Highlight {
  label: string;
  description: string;
  icon: "home" | "person" | "check" | "globe";
}

const highlights: Highlight[] = [
  { label: "Northern Virginia", description: "Primary market expertise", icon: "home" },
  { label: "Personal Service", description: "Dedicated, one-on-one attention", icon: "person" },
  { label: "Strategic Guidance", description: "Results-focused approach", icon: "check" },
  { label: "International Expertise", description: "Global real estate assistance", icon: "globe" },
];
---

<section
  class="py-10 px-6 lg:px-10 border-y border-border bg-white"
  aria-label="Why choose Tarik Real Estate"
>
  <div class="max-w-350 mx-auto">
    <div class="reveal grid grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-0 lg:divide-x lg:divide-border">
      {highlights.map((item) => (
        <div class="flex items-start gap-4 lg:px-10 first:pl-0 last:pr-0">
          <div class="shrink-0 mt-0.5">
            {item.icon === "home" && (
              <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
                <path d="M11 1L21 8V21H14V15H8V21H1V8L11 1Z" stroke="#b8956a" stroke-width="1.3" fill="none" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            )}
            {item.icon === "person" && (
              <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
                <circle cx="11" cy="7" r="4" stroke="#b8956a" stroke-width="1.3" />
                <path d="M3 20c0-4.4 3.6-8 8-8s8 3.6 8 8" stroke="#b8956a" stroke-width="1.3" stroke-linecap="round" />
              </svg>
            )}
            {item.icon === "check" && (
              <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
                <path d="M3 11l8 8L19 5" stroke="#b8956a" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            )}
            {item.icon === "globe" && (
              <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
                <circle cx="11" cy="11" r="9" stroke="#b8956a" stroke-width="1.3" />
                <ellipse cx="11" cy="11" rx="4" ry="9" stroke="#b8956a" stroke-width="1.3" />
                <path d="M2 11h18" stroke="#b8956a" stroke-width="1.3" />
              </svg>
            )}
          </div>
          <div>
            <p class="text-charcoal font-medium text-[13px] leading-snug">{item.label}</p>
            <p class="text-warm-gray-light text-[11px] mt-0.5 leading-snug">{item.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
