---
import { Image } from "astro:assets";
import { siteConfig } from "../../data/site-config";
import agentPhoto from "../../assets/profile/profile-4.jpg";
---

<section
  id="about"
  class="py-20 lg:py-32 px-6 lg:px-10 bg-cream"
  aria-labelledby="about-heading"
>
  <div class="max-w-350 mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-14 lg:gap-24 items-center">
      {/* Image */}
      <div class="reveal order-2 lg:order-1">
        <div class="relative">
          <div class="relative overflow-hidden aspect-3/4 max-w-120 mx-auto lg:mx-0">
            <Image
              src={agentPhoto}
              alt={`${siteConfig.agent.fullName}, ${siteConfig.agent.title} — Tarik Real Estate, Alexandria, Virginia`}
              loading="lazy"
              class="w-full h-full object-cover object-top"
            />
          </div>
          {/* Accent */}
          <div
            class="absolute -bottom-4 -left-4 lg:-bottom-5 lg:-left-5 w-2/3 h-2/3 border border-gold/25 -z-10"
            aria-hidden="true"
          ></div>
          {/* Floating label */}
          <div class="absolute bottom-6 right-4 lg:top-6 lg:bottom-auto lg:-right-8 bg-white border border-border px-6 py-4 shadow-lg">
            <p class="font-serif text-charcoal text-lg font-medium leading-tight">{siteConfig.agent.fullName}</p>
            <p class="text-gold text-[10px] tracking-[0.2em] uppercase font-medium mt-1">{siteConfig.agent.title}</p>
            <p class="text-warm-gray text-[11px] mt-1">Alexandria, VA</p>
          </div>
        </div>
      </div>

      {/* Text */}
      <div class="reveal reveal-delay-2 order-1 lg:order-2">
        <span class="section-divider mb-5" aria-hidden="true"></span>
        <p class="text-[10px] font-medium tracking-[0.3em] uppercase text-gold mb-4">
          About
        </p>
        <h2
          id="about-heading"
          class="font-serif text-charcoal text-3xl lg:text-4xl xl:text-5xl font-medium leading-tight mb-6"
        >
          Real Estate With a
          <br />
          Personal Perspective.
        </h2>

        <div class="space-y-4 text-warm-gray text-base leading-relaxed">
          <p>
            Tarik Jabrane founded Tarik Jabrane Realty around a simple
            principle: real estate should feel less like a transaction and
            more like a trusted relationship.
          </p>
          <p>
            Serving clients throughout greater Northern Virginia and the
            surrounding DMV region, Tarik works with homebuyers, sellers,
            investors, and relocating families who value thoughtful advice,
            responsive communication, and personalized service.
          </p>
          <p>
            When the decision involves your home, your family, or your
            investment, experience matters — but so does having someone
            who listens.
          </p>
          <p>
            Tarik combines local market knowledge with a straightforward,
            relationship-first approach. He takes the time to understand
            what matters to you, communicates clearly, and stays engaged
            throughout the process.
          </p>
          <p>
            Whether you're navigating your first purchase, preparing to
            sell, relocating across the DMV, or exploring property in
            Morocco, you can expect guidance that is personal, responsive,
            and grounded in your goals.
          </p>
          <p>
            A strong understanding of greater Northern Virginia and the
            communities that make the region unique means the difference
            between simply finding a property and making a decision that
            fits your goals — whether you're searching for your first
            home, your next home, a luxury property, or an investment
            opportunity.
          </p>
        </div>

        <div class="mt-8 pt-8 border-t border-border">
          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-1 2xl:grid-cols-3 gap-4">
            <div>
              <p class="font-serif text-charcoal text-base font-medium leading-snug">Northern Virginia</p>
              <p class="text-warm-gray text-[12px] mt-1 tracking-wide">Primary Market</p>
            </div>
            <div>
              <p class="font-serif text-charcoal text-base font-medium leading-snug">Surrounding Counties</p>
              <p class="text-warm-gray text-[12px] mt-1 tracking-wide">Extended Service Area</p>
            </div>
            <div class="col-span-2 sm:col-span-1">
              <p class="font-serif text-charcoal text-base font-medium leading-snug">Morocco & International</p>
              <p class="text-warm-gray text-[12px] mt-1 tracking-wide">Global Real Estate Assistance</p>
            </div>
          </div>
        </div>

        <button
          type="button"
          data-enquiry-open
          data-variant="general"
          class="inline-flex items-center gap-2 mt-8 text-[11px] font-medium tracking-[0.2em] uppercase text-charcoal hover:text-gold transition-colors duration-200 group focus-visible:outline-gold pb-1 border-b border-charcoal hover:border-gold"
        >
          Meet Tarik
          <svg
            width="14"
            height="14"
            viewBox="0 0 14 14"
            fill="none"
            class="transition-transform duration-300 group-hover:translate-x-1"
          >
            <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>
