---
import { siteConfig } from "../../data/site-config";
---

<section
  id="contact"
  class="py-28 lg:py-40 px-6 lg:px-10 bg-cream-dark"
  aria-labelledby="cta-heading"
>
  <div class="max-w-350 mx-auto">
    <div class="reveal flex flex-col lg:flex-row lg:items-end lg:justify-between gap-12">
      {/* Left */}
      <div class="max-w-2xl">
        <span class="section-divider mb-5" aria-hidden="true"></span>
        <p class="text-[10px] font-medium tracking-[0.3em] uppercase text-gold mb-4">
          Get In Touch
        </p>
        <h2
          id="cta-heading"
          class="font-serif text-charcoal text-4xl lg:text-5xl xl:text-6xl font-medium leading-tight mb-6"
        >
          Ready to Make
          <br />
          Your Next Move?
        </h2>
        <p class="text-warm-gray text-base lg:text-lg leading-relaxed max-w-lg">
          Let's talk about your real estate goals — whether you're buying,
          selling, or simply exploring what's possible in the Alexandria
          and Northern Virginia market.
        </p>
      </div>

      {/* Right — contact options */}
      <div class="flex flex-col gap-6 lg:min-w-75">
        {/* Primary CTA */}
        <button
          type="button"
          data-enquiry-open
          data-variant="general"
          class="inline-flex items-center justify-between gap-4 px-8 py-5 bg-charcoal text-white text-[11px] font-medium tracking-[0.2em] uppercase hover:bg-gold transition-all duration-300 focus-visible:outline-gold group"
        >
          Contact Tarik
          <svg
            width="16"
            height="16"
            viewBox="0 0 16 16"
            fill="none"
            class="transition-transform duration-300 group-hover:translate-x-1"
          >
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>

        {/* Contact details */}
        <div class="space-y-3 text-[13px] text-warm-gray">
          <div class="flex items-center gap-3">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" class="shrink-0 text-gold">
              <path d="M1.5 3.5C1.5 2.4 2.4 1.5 3.5 1.5h.6c.4 0 .8.25.95.63l.9 2.1c.17.4.07.87-.25 1.17l-.7.65c.6 1.2 1.5 2.1 2.7 2.7l.65-.7c.3-.32.77-.42 1.17-.25l2.1.9c.38.15.63.55.63.95v.6c0 1.1-.9 2-2 2C4.4 12.5 1.5 9.6 1.5 3.5z" stroke="currentColor" stroke-width="1.2" />
            </svg>
            <a href={siteConfig.contact.phoneHref} class="text-warm-gray-light hover:text-gold transition-colors duration-200 focus-visible:outline-gold">
              {siteConfig.contact.phone}
            </a>
          </div>
          <div class="flex items-center gap-3">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" class="shrink-0 text-gold">
              <path d="M1.5 3.5h11v7h-11zM1.5 3.5l5.5 4 5.5-4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <a href={`mailto:${siteConfig.contact.email}`} class="text-warm-gray-light hover:text-gold transition-colors duration-200 focus-visible:outline-gold">
              {siteConfig.contact.email}
            </a>
          </div>
          <div class="flex items-center gap-3">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" class="shrink-0 text-gold">
              <path d="M7 1.5C4.5 1.5 2.5 3.5 2.5 6c0 3.5 4.5 6.5 4.5 6.5s4.5-3 4.5-6.5c0-2.5-2-4.5-4.5-4.5z" stroke="currentColor" stroke-width="1.2" />
              <circle cx="7" cy="6" r="1.5" stroke="currentColor" stroke-width="1.2" />
            </svg>
            <span class="text-warm-gray-light">{siteConfig.contact.location}</span>
          </div>
        </div>

        {/* Social links */}
        <div class="flex items-center gap-3">
          <a
            href={siteConfig.socialLinks.facebook}
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 border border-charcoal/15 flex items-center justify-center text-warm-gray hover:text-gold hover:border-gold transition-colors duration-200 focus-visible:outline-gold"
            aria-label="Tarik Real Estate on Facebook"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z" />
            </svg>
          </a>
          <a
            href={siteConfig.socialLinks.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 border border-charcoal/15 flex items-center justify-center text-warm-gray hover:text-gold hover:border-gold transition-colors duration-200 focus-visible:outline-gold"
            aria-label="Tarik Real Estate on Instagram"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" />
              <path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z" />
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
            </svg>
          </a>
          <a
            href={siteConfig.socialLinks.tiktok}
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 border border-charcoal/15 flex items-center justify-center text-warm-gray hover:text-gold hover:border-gold transition-colors duration-200 focus-visible:outline-gold"
            aria-label="Tarik Real Estate on TikTok"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16.5 2h-3v14.5a2.5 2.5 0 11-2.5-2.5c.17 0 .34.01.5.04V10.9a5.5 5.5 0 105.5 5.5V8.5a7.44 7.44 0 004.5 1.5v-3a4.5 4.5 0 01-4.5-4.5z" stroke-linejoin="round" />
            </svg>
          </a>
          <a
            href={siteConfig.contact.whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 border border-charcoal/15 flex items-center justify-center text-warm-gray hover:text-gold hover:border-gold transition-colors duration-200 focus-visible:outline-gold"
            aria-label="Message Tarik Real Estate on WhatsApp"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2a9.98 9.98 0 00-8.62 15.02L2 22l5.12-1.34A10 10 0 1012 2z" />
              <path d="M8.5 8.6c.2-.5.4-.6.7-.6h.5c.2 0 .3.1.4.3.2.4.6 1.4.7 1.5.1.2.1.3 0 .5-.1.2-.2.3-.3.4-.2.2-.3.3-.1.6.2.3.7 1 1.4 1.6.8.7 1.5 1 1.8 1.1.2.1.4.1.5-.1.2-.2.6-.7.8-.9.2-.2.3-.2.5-.1.2.1 1.3.6 1.5.7.2.1.4.2.4.3.1.2 0 .8-.2 1.1-.3.4-1.1.7-1.6.8-.5.1-1 .1-2.9-.7-1.9-.8-3.4-2.5-3.5-2.6-.1-.2-.9-1.2-.9-2.3 0-1.1.6-1.7.8-1.9z" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
