---
import { Image } from "astro:assets";
import { articles } from "../../data/insights";
---

<section
  id="insights"
  class="py-20 lg:py-32 px-6 lg:px-10 bg-cream"
  aria-labelledby="insights-heading"
>
  <div class="max-w-350 mx-auto">
    {/* Header */}
    <div class="reveal flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-14">
      <div>
        <span class="section-divider mb-5" aria-hidden="true"></span>
        <p class="text-[10px] font-medium tracking-[0.3em] uppercase text-gold mb-4">
          Resources
        </p>
        <h2
          id="insights-heading"
          class="font-serif text-charcoal text-3xl lg:text-4xl xl:text-5xl font-medium leading-tight"
        >
          Real Estate
          <br />
          Insights
        </h2>
        <p class="text-warm-gray text-base mt-4 max-w-md leading-relaxed">
          Practical guidance for buyers, sellers, and homeowners in the Northern Virginia market.
        </p>
      </div>
      <a
        href="/resources"
        class="hidden items-center gap-2 text-[11px] font-medium tracking-[0.2em] uppercase text-charcoal hover:text-gold transition-colors duration-200 group focus-visible:outline-gold self-start lg:self-auto pb-1 border-b border-charcoal hover:border-gold"
      >
        All Articles
        <svg
          width="14"
          height="14"
          viewBox="0 0 14 14"
          fill="none"
          class="transition-transform duration-300 group-hover:translate-x-1"
        >
          <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>

    {/* Articles */}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-10">
      {articles.map((article, index) => (
        <div class="reveal" style={`transition-delay: ${index * 100}ms`}>
          <button
            type="button"
            data-article-open
            data-article-id={article.id}
            class="group block w-full text-left focus-visible:outline-gold"
            aria-label={`Read article: ${article.title}`}
          >
            {/* Image */}
            <div class="relative overflow-hidden aspect-16/10 mb-6">
              <Image
                src={article.image}
                alt={article.imageAlt}
                loading="lazy"
                width={800}
                height={500}
                class="w-full h-full object-cover object-center transition-transform duration-600 group-hover:scale-105"
              />
              {/* Category badge */}
              <div class="absolute top-4 left-4">
                <span class="inline-block px-3 py-1 bg-charcoal/80 text-white text-[9px] tracking-[0.2em] uppercase font-medium backdrop-blur-sm">
                  {article.category}
                </span>
              </div>
            </div>

            {/* Content */}
            <div>
              <h3 class="font-serif text-charcoal text-xl font-medium leading-snug mb-3 group-hover:text-gold transition-colors duration-200">
                {article.title}
              </h3>
              <p class="text-warm-gray text-[13px] leading-relaxed mb-4 line-clamp-3">
                {article.excerpt}
              </p>
              <div class="inline-flex items-center gap-2 text-[11px] font-medium tracking-[0.18em] uppercase text-gold group-hover:text-gold-dark transition-colors duration-200">
                Read Article
                <svg
                  width="12"
                  height="12"
                  viewBox="0 0 12 12"
                  fill="none"
                  class="transition-transform duration-300 group-hover:translate-x-1"
                >
                  <path d="M2 6h8M6 3l3 3-3 3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </div>
            </div>
          </button>
        </div>
      ))}
    </div>
  </div>

  {/* Article modal — pre-rendered content for every article, toggled by JS */}
  <div
    data-article-modal
    class="hidden fixed inset-0 z-200 items-center justify-center bg-charcoal/80 p-4"
  >
    <div
      role="dialog"
      aria-modal="true"
      tabindex="-1"
      data-article-dialog
      class="relative w-full max-w-2xl max-h-[85vh] overflow-y-auto bg-cream shadow-2xl outline-none animate-scale-in"
    >
      <button
        type="button"
        data-article-close
        aria-label="Close"
        class="absolute top-4 right-4 z-10 w-8 h-8 flex items-center justify-center bg-cream/90 text-warm-gray-light hover:text-charcoal focus-visible:outline-gold transition-colors duration-200"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M12 4L4 12M4 4l8 8" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
        </svg>
      </button>

      {articles.map((article, index) => (
        <div data-article-panel={article.id} hidden>
          <div class="relative overflow-hidden aspect-video">
            <Image
              src={article.image}
              alt={article.imageAlt}
              loading={index === 0 ? "eager" : "lazy"}
              width={1000}
              height={560}
              class="w-full h-full object-cover object-center"
            />
          </div>
          <div class="p-8 lg:p-10">
            <span class="inline-block px-3 py-1 bg-charcoal text-white text-[9px] tracking-[0.2em] uppercase font-medium mb-4">
              {article.category}
            </span>
            <h2
              id={`article-modal-title-${article.id}`}
              class="font-serif text-charcoal text-2xl lg:text-3xl font-medium leading-snug mb-3"
            >
              {article.title}
            </h2>
            <p class="text-warm-gray-light text-[12px] tracking-wide uppercase mb-6">
              {new Date(article.publishedAt).toLocaleDateString("en-US", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })}
            </p>
            <div class="space-y-4 text-warm-gray text-[15px] leading-relaxed">
              {article.content.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // Dependency-free modal, same pattern as the Hero/Areas sliders: every
  // article's full content is pre-rendered in the page and just toggled by
  // id, instead of hydrating a framework component or routing to a page
  // that doesn't exist yet.
  const modal = document.querySelector<HTMLElement>("[data-article-modal]");
  const dialog = document.querySelector<HTMLElement>("[data-article-dialog]");
  const panels = Array.from(document.querySelectorAll<HTMLElement>("[data-article-panel]"));

  if (modal && dialog && panels.length) {
    let previouslyFocused: HTMLElement | null = null;

    const openArticle = (id: string) => {
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.articlePanel !== id;
      });
      dialog.setAttribute("aria-labelledby", `article-modal-title-${id}`);
      previouslyFocused = document.activeElement as HTMLElement | null;
      modal.classList.remove("hidden");
      modal.classList.add("flex");
      document.documentElement.style.overflow = "hidden";
      document.body.style.overflow = "hidden";
      dialog.scrollTop = 0;
      dialog.focus({ preventScroll: true });
    };

    const closeArticle = () => {
      modal.classList.add("hidden");
      modal.classList.remove("flex");
      document.documentElement.style.overflow = "";
      document.body.style.overflow = "";
      previouslyFocused?.focus({ preventScroll: true });
    };

    document.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      const trigger = target.closest<HTMLElement>("[data-article-open]");
      if (trigger) {
        event.preventDefault();
        const id = trigger.dataset.articleId;
        if (id) openArticle(id);
        return;
      }
      if (!modal.classList.contains("hidden") && (target === modal || target.closest("[data-article-close]"))) {
        closeArticle();
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !modal.classList.contains("hidden")) {
        closeArticle();
      }
    });
  }
</script>
