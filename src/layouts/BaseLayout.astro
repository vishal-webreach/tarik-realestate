---
import { getImage } from "astro:assets";
import Header from "../components/react/Header";
import Footer from "../components/astro/Footer.astro";
import ScrollToTopButton from "../components/astro/ScrollToTopButton.astro";
import GoogleTagManager from "../components/astro/GoogleTagManager.astro";
import GoogleTagManagerNoscript from "../components/astro/GoogleTagManagerNoscript.astro";
import GoogleAnalytics from "../components/astro/GoogleAnalytics.astro";
import EnquiryModal from "../components/react/EnquiryModal";
import PropertyDetailModal from "../components/astro/PropertyDetailModal.astro";
import { siteConfig, seoConfig } from "../data/site-config";
import { BASE_URL } from "../lib/baseUrl";
import brickMansion from "../assets/photos/brickMansion.jpg";
import crest from "../assets/branding/crest.png";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Social share preview image — standard 1200x630 OG size.
const ogImage = await getImage({ src: brickMansion, width: 1200, height: 630, format: "jpg" });
const ogImageURL = new URL(ogImage.src, Astro.site);

const logoURL = new URL(crest.src, Astro.site);

// https://schema.org/RealEstateAgent — lets search engines and AI assistants
// surface the agent's name, service area, and contact info directly, not
// just a generic page link.
const structuredData = {
  "@context": "https://schema.org",
  "@type": "RealEstateAgent",
  name: siteConfig.business.name,
  image: logoURL.href,
  logo: logoURL.href,
  url: canonicalURL.href,
  telephone: siteConfig.contact.phone,
  email: siteConfig.contact.email,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Alexandria",
    addressRegion: "VA",
    addressCountry: "US",
  },
  areaServed: siteConfig.areasServed,
  sameAs: Object.values(siteConfig.socialLinks),
  employee: {
    "@type": "Person",
    name: siteConfig.agent.fullName,
    jobTitle: siteConfig.agent.title,
  },
};
---

<html lang="en">
  <head>
    <GoogleTagManager />
    <GoogleAnalytics />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={seoConfig.keywords.join(", ")} />
    <meta name="author" content={siteConfig.agent.fullName} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={siteConfig.business.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${siteConfig.business.name} — ${siteConfig.business.tagline}`} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    {seoConfig.twitterHandle && <meta name="twitter:site" content={seoConfig.twitterHandle} />}

    <!-- Structured data (schema.org RealEstateAgent) -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Inter:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" href={`${BASE_URL}favicon.ico`} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={`${BASE_URL}favicon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${BASE_URL}favicon-16x16.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${BASE_URL}apple-touch-icon.png`} />
    <link rel="manifest" href={`${BASE_URL}site.webmanifest`} />
    <meta name="theme-color" content="#faf8f5" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <GoogleTagManagerNoscript />
    <!-- Skip to main content — accessibility -->
    <a
      href="#main-content"
      class="fixed -top-full left-4 z-200 px-4 py-2 bg-gold text-white text-sm font-medium focus:top-4 transition-all"
    >
      Skip to main content
    </a>

    <Header client:load />

    <main id="main-content">
      <slot />
    </main>

    <Footer />

    <ScrollToTopButton />

    <EnquiryModal client:idle />
    <PropertyDetailModal />

    <script>
      // Delegated click handler: any element with data-enquiry-open dispatches
      // the enquiry:open event that EnquiryModal.tsx listens for. Keeps every
      // trigger button in static Astro markup — no per-button hydration.
      document.addEventListener("click", (event) => {
        const trigger = (event.target as HTMLElement).closest<HTMLElement>("[data-enquiry-open]");
        if (!trigger) return;
        event.preventDefault();
        window.dispatchEvent(
          new CustomEvent("enquiry:open", {
            detail: {
              listingId: trigger.dataset.listingId,
              variant: trigger.dataset.variant,
            },
          })
        );
      });

      // Shared scroll-reveal: a single IntersectionObserver drives the
      // `.reveal` → `.reveal.visible` transition (defined in global.css) for
      // every static section on the page, instead of each section running
      // its own observer.
      // Exclude .reveal elements inside React islands (e.g. Testimonials) —
      // those manage their own reveal state via useReveal() and would fight
      // with this shared observer over the same DOM node, causing a
      // hydration mismatch.
      const revealTargets = Array.from(document.querySelectorAll<HTMLElement>(".reveal")).filter(
        (el) => !el.closest("astro-island")
      );
      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (prefersReducedMotion) {
        revealTargets.forEach((el) => el.classList.add("visible"));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("visible");
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12 }
        );
        revealTargets.forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>
